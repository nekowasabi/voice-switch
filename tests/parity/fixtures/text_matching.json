{
  "normalization": [
    {
      "name": "drops spaces and Japanese punctuation",
      "input": " 音声 入力。",
      "expected": "音声入力"
    },
    {
      "name": "drops western punctuation",
      "input": "wake, word!?",
      "expected": "wakeword"
    },
    {
      "name": "keeps meaningful kana and kanji",
      "input": "「入力ストップ」",
      "expected": "入力ストップ"
    },
    {
      "name": "folds Latin case so a recognized ST matches a configured st",
      "input": "ST",
      "expected": "st"
    }
  ],
  "decision_config": {
    "wakeWords": ["音声入力", "おんせい"],
    "locale": "ja_JP",
    "command": "echo wake",
    "stopWords": ["入力ストップ"],
    "stopCommand": "echo stop",
    "maxSeconds": 2.5,
    "hangoverMs": 300,
    "prerollMs": 300,
    "minSpeechMs": 300,
    "vadRatio": 3.0,
    "vadMinRMS": 0.005,
    "dictation": {
      "recordingsDir": "%LOCALAPPDATA%\\com.superwhisper.app\\recordings",
      "endSilenceMs": 1200,
      "startTimeoutMs": 3000,
      "maxSeconds": 60,
      "excludeBundleIDs": []
    }
  },
  "agreement_min": 3,
  "agreement": [
    { "name": "an empty transcript shares nothing", "a": "", "b": "おかんのおかんのおかんの", "expected": 0 },
    { "name": "full and half width digits and a trailing 。 match", "a": "今日の会議は3時からです", "b": "今日の会議は３時からです。", "expected": 12 },
    { "name": "a backchannel stays under the minimum", "a": "はい", "b": "はい!", "expected": 2 },
    { "name": "one misheard kana costs one character", "a": "ブロックホットのアプリ", "b": "ブロックボットのアプリ", "expected": 10 }
  ],
  "decisions": [
    {
      "name": "wake word is a whole normalized utterance",
      "recognized": "音声 入力。",
      "kind": "run-command",
      "command": "echo wake",
      "reason": "wake",
      "text": "音声入力"
    },
    {
      "name": "stop word uses stop command",
      "recognized": "入力ストップ",
      "kind": "run-command",
      "command": "echo stop",
      "reason": "stop",
      "text": "入力ストップ"
    },
    {
      "name": "embedded wake phrase is ignored",
      "recognized": "音声入力してください",
      "kind": "ignore",
      "command": null,
      "reason": "not a configured word",
      "text": "音声入力してください"
    }
  ]
}
