{
  "wakeWords": ["音声入力"],
  "locale": "ja_JP",
  "command": "rundll32 url.dll,FileProtocolHandler superwhisper://record",
  "stopWords": ["入力ストップ"],
  "skipWhileMicInUseBy": ["Superwhisper"],
  "maxSeconds": 2.5,
  "hangoverMs": 300,
  "prerollMs": 300,
  "minSpeechMs": 300,
  "vadRatio": 3.0,
  "vadMinRMS": 0.005,
  "dictation": {
    "recordingsDir": "%LOCALAPPDATA%\\com.superwhisper.app\\recordings",
    "endSilenceMs": 2400,
    "startTimeoutMs": 3000,
    "maxSeconds": 60,
    "excludeProcessNames": [],
    "superwhisperMode": "voice_switch"
  },
  "macOS": {
    "wakeURL": "superwhisper://record/start",
    "stopURL": "superwhisper://record/stop",
    "actions": [
      {
        "name": "grokbot-webhook",
        "wakeWords": ["ボットに送信"],
        "url": "https://YOUR-WORKER.workers.dev/",
        "tokenEnv": "VOICE_SWITCH_GROKBOT_TOKEN",
        "fields": {
          "transcription": "{text}",
          "recordedAt": "{recordedAtMs}",
          "client": "ring"
        }
      },
      {
        "name": "grokbot",
        "wakeWords": ["グロック", "grok bot"],
        "url": "grokbot://app/v1/prompt?id=YOUR_BOT_ID",
        "inputParam": "text"
      }
    ]
  },
  "windows": {
    "actions": [
      {
        "name": "grokbot-webhook",
        "wakeWords": ["ボットに送信"],
        "url": "https://YOUR-WORKER.workers.dev/",
        "tokenEnv": "VOICE_SWITCH_GROKBOT_TOKEN",
        "fields": {
          "transcription": "{text}",
          "recordedAt": "{recordedAtMs}",
          "client": "ring"
        }
      },
      {
        "name": "grokbot",
        "wakeWords": ["グロック", "grok bot"],
        "url": "grokbot://app/v1/prompt?id=YOUR_BOT_ID",
        "inputParam": "text"
      }
    ]
  }
}
