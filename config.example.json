  "maxSeconds": 2.5,
  "hangoverMs": 300,
  "prerollMs": 300,
  "minSpeechMs": 300,
  "vadRatio": 3.0,
  "vadMinRMS": 0.005,
  "dictation": {
    "recordingsDir": "~/Documents/superwhisper/recordings",
    "endSilenceMs": 1200, "startTimeoutMs": 3000,
    "maxSeconds": 60,
    "excludeBundleIDs": [],
    "superwhisperMode": "voice_switch"
  }
}
