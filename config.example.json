{
  "wakeWords": ["音声入力", "音声入る", "おんせい", "音声に入るよ", "音声に入る", "音声によって"],
  "locale": "ja_JP",
  "command": "open -g superwhisper://record",
  "skipWhileMicInUseBy": ["com.superduper.superwhisper"],
  "stopWords": ["入力ストップ"],
