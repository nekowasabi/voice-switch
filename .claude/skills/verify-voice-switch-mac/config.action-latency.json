{
  "wakeWords": ["音声入力"],
  "locale": "ja_JP",
  "command": "touch __EVIDENCE__/wake.marker",
  "maxSeconds": 2.5,
  "hangoverMs": __HANGOVER__,
  "prerollMs": 300,
  "minSpeechMs": 300,
  "vadRatio": 3.0,
  "vadMinRMS": 0.005,
  "dictation": {
    "endSilenceMs": 1200,
    "startTimeoutMs": 3000,
    "maxSeconds": 60,
    "excludeBundleIDs": [],
    "superwhisperMode": "vs-verify-missing"
  },
  "macOS": {
    "actions": [
      { "name": "latency", "wakeWords": ["__WORD__"], "command": "touch __EVIDENCE__/action.marker" }
    ]
  }
}
