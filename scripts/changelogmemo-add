#!/usr/bin/env python3
from collections import Counter
import ctypes
import datetime
import errno
import fcntl
import math
import os
from pathlib import Path
import re
import select
import stat
import sys
import tempfile
import time


MIN_OBSERVATION = 0.025


def exchange(pending, path):
    libc = ctypes.CDLL(None, use_errno=True)
    source, destination = os.fsencode(pending), os.fsencode(path)
    if sys.platform == "darwin":
        result = libc.renamex_np(source, destination, ctypes.c_uint(0x00000002))  # RENAME_SWAP
    elif sys.platform.startswith("linux") and hasattr(libc, "renameat2"):
        result = libc.renameat2(-100, source, -100, destination, ctypes.c_uint(2))  # AT_FDCWD, RENAME_EXCHANGE
    else:
        raise OSError(errno.ENOTSUP, "atomic file exchange unavailable", path)
    if result != 0:
        error = ctypes.get_errno()
        raise OSError(error, os.strerror(error), path)


def snapshot(path):
    try:
        with path.open("rb") as stream:
            mode = stat.S_IMODE(os.fstat(stream.fileno()).st_mode)
            contents = stream.read()
    except FileNotFoundError:
        return None, b"  takets <nolifeking00@gmail.com>", b"", 0o600
    header, _, rest = contents.partition(b"\n")
    if re.match(rb"^\d{4}-\d\d-\d\d  ", header):
        return contents, header[10:], rest.removeprefix(b"\n"), mode
    return contents, b"  takets <nolifeking00@gmail.com>", contents, mode


def merge(current, retained, base=b""):
    if current.endswith(retained):
        return current
    if retained.endswith(current):
        return retained
    if base and current.endswith(base) and retained.endswith(base):
        return merge(current[:-len(base)], retained[:-len(base)]) + base
    sections = re.compile(rb"(?m)(?=^\* )")
    current_entries = sections.split(current)
    retained_entries = sections.split(retained)
    while retained_entries and current_entries and retained_entries[-1] == current_entries[-1]:
        retained_entries.pop()
        current_entries.pop()
    counts = Counter(current_entries)
    missing = []
    for entry in retained_entries:
        if counts[entry]:
            counts[entry] -= 1
        else:
            missing.append(entry)
    return b"".join(missing) + current


def check_deadline(deadline):
    if time.monotonic() >= deadline:
        raise TimeoutError


def read_input(deadline):
    fd = sys.stdin.fileno()
    chunks = []
    while True:
        check_deadline(deadline)
        if not select.select([fd], [], [], min(1, max(0, deadline - time.monotonic())))[0]:
            continue
        chunk = os.read(fd, 65536)
        if not chunk:
            return b"".join(chunks)
        chunks.append(chunk)


def file_stamp(path):
    try:
        info = path.stat()
        return info.st_ino, info.st_mtime_ns, info.st_size
    except FileNotFoundError:
        return None


def wait_for_quiet(path, deadline):
    # Give a writer that is actively replacing the file priority over our exchange.
    stamp = file_stamp(path)
    since = time.monotonic()
    last_replacement = None
    quiet_for = 0.006
    while True:
        check_deadline(deadline)
        time.sleep(0.001)
        current = file_stamp(path)
        now = time.monotonic()
        if current != stamp:
            stamp, since = current, now
            if current is not None and last_replacement is not None:
                between_writes = current[1] - last_replacement[1]
                if 0 <= between_writes < 8_000_000:
                    quiet_for = 0.25
            last_replacement = current
        elif current is None or now - since >= quiet_for:
            return stamp


def after_publish(path, published, raced, deadline):
    # shortcut: A blind replacement delayed past this check needs writer cooperation.
    deadline = min(deadline, time.monotonic() + (0.25 if raced else MIN_OBSERVATION))
    while True:
        current = snapshot(path)
        if current[0] != published or time.monotonic() >= deadline:
            return current
        time.sleep(0.001)


def prepend(path, details, title, deadline):
    today = datetime.date.today().isoformat().encode()
    entry = (f"* {title} {today.decode()} [note]: [voice-switch]:\n"
             f"  - 内容: {details[0]}\n"
             + "".join(f"    {line}\n" for line in details[1:]) + "\n").encode()
    path.parent.mkdir(parents=True, exist_ok=True)
    with Path(str(path) + ".lock").open("a") as lock:
        waited_for_lock = False
        while True:
            check_deadline(deadline)
            try:
                fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except BlockingIOError:
                waited_for_lock = True
                time.sleep(0.001)
        previous, author, rest, mode = snapshot(path)
        retained = entry + rest
        # A sequential call may overlap a writer that read the old file and has yet to replace it.
        raced = previous is not None and not waited_for_lock
        while True:
            stamp = wait_for_quiet(path, deadline)
            current, current_author, current_rest, current_mode = snapshot(path)
            if current != previous:
                raced = True
                retained = merge(current_rest, retained, rest)
                previous, author, rest, mode = current, current_author, current_rest, current_mode
            if file_stamp(path) != stamp:
                raced = True
                continue
            fd, name = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
            pending_path = Path(name)
            displaced = False
            try:
                published = today + author + b"\n\n" + retained
                with os.fdopen(fd, "wb") as pending:
                    os.fchmod(pending.fileno(), mode)
                    pending.write(published)
                    pending.flush()
                    os.fsync(pending.fileno())
                if snapshot(path)[0] != previous or file_stamp(path) != stamp:
                    raced = True
                    continue
                # An exchange needs time to see and reconcile a stale replacement before reporting success.
                check_deadline(deadline - (MIN_OBSERVATION if previous is not None else 0))
                try:
                    if previous is None:
                        os.link(pending_path, path)
                    else:
                        exchange(pending_path, path)
                        displaced = True
                except (FileExistsError, FileNotFoundError):
                    raced = True
                    current = snapshot(path)
                else:
                    if displaced:
                        replaced, _, replaced_rest, _ = snapshot(pending_path)
                        if replaced != previous:
                            raced = True
                            retained = merge(retained, replaced_rest, rest)
                    current = after_publish(path, published, raced, deadline)
                    raced = raced or current[0] != published
                previous, author, current_rest, mode = current
                combined = merge(current_rest, retained, rest)
                if combined == current_rest:
                    return
                retained = combined
                rest = current_rest
            finally:
                if not displaced or sys.exc_info()[0] is None:
                    pending_path.unlink(missing_ok=True)


def main():
    titles = {"task": "自分の作業", "draft": "下書き"}
    if len(sys.argv) != 2 or sys.argv[1] not in titles:
        sys.exit("usage: changelogmemo-add task|draft < dictation.txt")
    try:
        seconds = float(os.environ.get("CHANGELOGMEMO_TIMEOUT_SECONDS", "1.25"))
        if not math.isfinite(seconds) or seconds <= 0:
            raise ValueError
    except ValueError:
        sys.exit("changelogmemo-add: CHANGELOGMEMO_TIMEOUT_SECONDS must be positive and finite")
    deadline = time.monotonic() + seconds
    try:
        details = read_input(deadline).decode("utf-8").strip().splitlines()
        if not details:
            sys.exit("changelogmemo-add: empty input")
        path = Path(os.environ.get("CHANGELOG_FILE") or "~/repos/changelog/changelogmemo").expanduser().resolve()
        prepend(path, details, titles[sys.argv[1]], deadline)
    except TimeoutError:
        print("changelogmemo-add: time limit exceeded", file=sys.stderr)
        sys.exit(os.EX_TEMPFAIL)


if __name__ == "__main__":
    main()
