{
  "wakeWords": ["音声入力", "音声入る", "おんせい", "音声に入るよ", "音声に入る", "音声によって"],
  "locale": "ja_JP",
  "command": "rundll32 url.dll,FileProtocolHandler superwhisper://record",
  "skipWhileMicInUseBy": ["Superwhisper"],
  "stopWords": ["入力ストップ"],
  "maxSeconds": 2.5,
  "hangoverMs": 300,
  "prerollMs": 300,
  "minSpeechMs": 300,
  "vadRatio": 3.0,
  "vadMinRMS": 0.005,
  "pauseShortcut": "Control+Shift+F7",
  "dictation": {
    "recordingsDir": "%LOCALAPPDATA%\\com.superwhisper.app\\recordings",
    "endSilenceMs": 1500, "startTimeoutMs": 3000,
    "maxSeconds": 60,
    "excludeProcessNames": [],
    "superwhisperMode": "voice_switch",
    // Windows だけ。本文のあとに続けた停止語を、別の SAPI 認識器で拾う。
    // 人の声と打鍵音は未測定なので既定は false。Mac は無視する。
    "dedicatedStopRecognizer": false,
    "noWakeWord": {
      "followup": false,
      "autoIdle": false,
      "relaxedReadingDistance2": false,
      "followupMs": 8000
    }
  }
}
